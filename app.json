{
  "expo": {
    "name": "Rutinia",
    "slug": "rutinia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rutinia",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080A0F",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "backgroundColor": "#080A0F"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "dark",
      "backgroundColor": "#080A0F"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#080A0F",
      "backgroundColor": "#080A0F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rutinia necesita acceder a tus fotos para que puedas personalizar tu avatar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
