# Copia este archivo como .env y rellena tus valores.
# La clave debe ser la "anon public" de Supabase (Settings → API).
# NUNCA uses la service_role key en una app móvil: ignora RLS y permite
# leer y borrar los datos de todas las cuentas.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
